# Tuya IoT Platform Credentials
TUYA_ACCESS_ID=your_tuya_access_id
TUYA_ACCESS_KEY=your_tuya_access_key
TUYA_ACCESS_SECRET=your_tuya_access_secret
TUYA_DEVICE_ID=your_device_id
TUYA_ENDPOINT=eu
TUYA_REGION=eu

# Upstash Redis (Serverless KV & state storage)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Upstash QStash & Workflow (Serverless cron scheduling and workflow step runner)
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# Public App URL for QStash callbacks (e.g. https://your-project.vercel.app)
# Falls back to VERCEL_PROJECT_PRODUCTION_URL if set in Vercel
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Dashboard Authentication
AUTH_USERNAME=admin
AUTH_PASSWORD=your_strong_password
SESSION_SECRET=replace_with_a_long_random_secret_string
